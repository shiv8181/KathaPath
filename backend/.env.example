# MongoDB connection
MONGODB_URL=mongodb://localhost:27017
MONGODB_DATABASE=kathapath

# LLM key for Hindi explanations (keep this secret; never expose it to the browser)
EMERGENT_LLM_KEY=
# Optional model override; default configured in backend/routers/ai.py
KATHAPATH_LLM_MODEL=claude-sonnet-5-5

# Comma-separated browser origins allowed to call the API
KATHAPATH_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional persistent upload directory
# KATHAPATH_UPLOAD_DIR=/var/lib/kathapath/uploads
